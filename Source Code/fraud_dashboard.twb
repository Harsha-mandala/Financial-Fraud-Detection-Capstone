    <worksheet name='Inflation Adjusted'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontsize='13'>Inflation-Adjusted Transaction Amounts by Week</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cc_data' name='federated.0qa5yxm1b1u8li14vhp4r1kfse4z' />
          </datasources>
          <datasource-dependencies datasource='federated.0qa5yxm1b1u8li14vhp4r1kfse4z'>
            <column caption='Inflation-Adjusted Transaction Amounts' datatype='real' name='[Calculation_2085525703561216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[amt] * (1 + 0.02) ^ (YEAR(TODAY()) - YEAR([trans_date_trans_time]))' />
            </column>
            <column caption='Amt' datatype='real' name='[amt]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2085525703561216]' derivation='Sum' name='[sum:Calculation_2085525703561216:qk]' pivot='key' type='quantitative' />
            <column-instance column='[amt]' derivation='Sum' name='[sum:amt:qk]' pivot='key' type='quantitative' />
            <column caption='Trans Date Trans Time' datatype='datetime' name='[trans_date_trans_time]' role='dimension' type='ordinal' />
            <column-instance column='[trans_date_trans_time]' derivation='Week-Trunc' name='[twk:trans_date_trans_time:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.0qa5yxm1b1u8li14vhp4r1kfse4z].[sum:amt:qk]' />
            </encodings>
            <style>
